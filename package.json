{
  "name": "svg-editor",
  "version": "0.1.0",
  "private": true,
  "description": "Lab1 Phase 1 - SVG editor CLI (TypeScript / Command + Composite)",
  "main": "dist/src/cli/Main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "cli": "npm run build --silent && node dist/src/cli/Main.js",
    "test": "npm run build --silent && node --test \"dist/test/*.test.js\"",
    "check:deps": "node scripts/check-deps.mjs",
    "verify": "npm run check:deps && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
